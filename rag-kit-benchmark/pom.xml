<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.derekdiliu</groupId>
        <artifactId>spring-ai-rag-kit-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rag-kit-benchmark</artifactId>
    <name>Spring AI RAG Kit :: BEIR benchmark</name>
    <description>Vector vs full-text vs hybrid retrieval on BEIR datasets. Not published; run with -Pbenchmark</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.derekdiliu</groupId>
            <artifactId>rag-kit-pgvector</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.derekdiliu</groupId>
            <artifactId>rag-kit-eval</artifactId>
        </dependency>
        <!-- PgTextSearchContainers: pgvector plus pg_textsearch for BM25 -->
        <dependency>
            <groupId>io.github.derekdiliu</groupId>
            <artifactId>rag-kit-pgvector</artifactId>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-transformers</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
        </dependency>
        <!-- Testcontainers needs it, but DJL (via spring-ai-transformers) is nearer and excludes it -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The benchmark runs in the integration-test phase: mvn -Pbenchmark -pl rag-kit-benchmark -am verify -DskipTests -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>beir</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>io.github.derekdiliu.ragkit.benchmark.BeirBenchmark</mainClass>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                    <systemProperties>
                        <systemProperty>
                            <key>benchmark.output</key>
                            <value>${project.build.directory}/beir-results.md</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
